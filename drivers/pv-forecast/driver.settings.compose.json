      "en": "Your PV surfaces",
      "de": "Deine PV-Flächen"
    },
    "children": [
      {
        "id": "segmentHint",
        "type": "label",
        "label": {
          "en": "Enter each roof/wall section separately (kWp, tilt, compass). Set kWp to 0 for unused rows. At least one surface is required.",
          "de": "Jede Dach-/Wandfläche einzeln eintragen (kWp, Neigung, Himmelsrichtung). kWp = 0 = Fläche aus. Mindestens eine Fläche ist Pflicht."
        }
      }
    ]
  },
