  {
    "type": "group",
    "label": {
      "en": "Fine tuning",
      "de": "Feinabstimmung"
    },
    "children": [
      {
        "id": "fineTuningHint",
        "type": "label",
        "label": {
          "en": "Performance ratio = how much sunshine your system can turn into power in theory (cables, inverter, heat). Set once, rarely change. Calibration factor = your personal tweak if the forecast is still consistently too high or low after a few days.",
          "de": "Wirkungsgrad-Faktor = wie viel Sonne deine Anlage grundsätzlich in Strom umsetzen kann (Kabel, Wechselrichter, Wärme). Einmal einstellen, selten ändern. Kalibrierungsfaktor = dein persönlicher Feinschliff, wenn die Prognose nach ein paar Tagen noch dauerhaft zu hoch oder zu niedrig ist."
        }
      },
      {
        "id": "performanceRatio",
        "type": "number",
        "label": { "en": "Performance ratio", "de": "Wirkungsgrad-Faktor" },
        "value": 0.85,
        "min": 0.5,
        "max": 1,
        "step": 0.01,
        "hint": {
          "en": "Typical 0.80–0.90. Lower = more losses (long cables, older inverter). Leave at 0.85 unless you know your system is very efficient or rather weak.",
          "de": "Typisch 0,80–0,90. Niedriger = mehr Verluste (lange Kabel, älterer Wechselrichter). 0,85 ist ein guter Start — nur ändern, wenn du deine Anlage kennst."
        }
      },
      {
        "id": "calibrationFactor",
        "type": "number",
        "label": { "en": "Calibration factor", "de": "Kalibrierungsfaktor" },
        "value": 1,
        "min": 0.5,
        "max": 1.5,
        "step": 0.05,
        "hint": {
          "en": "1.0 = no extra correction. Example: 0.90 lowers the forecast by 10 % if it is often too optimistic. Adjust only after comparing forecast vs. actual yield over several days.",
          "de": "1,0 = keine Extra-Korrektur. Beispiel: 0,90 senkt die Prognose um 10 %, wenn sie oft zu hoch liegt. Erst anpassen, wenn du Prognose und Ist-Wert einige Tage verglichen hast."
        }
      }
    ]
  },
